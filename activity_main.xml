<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#F5F7FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SELF CLEANER"
        android:textStyle="bold"
        android:textSize="30sp"
        android:textColor="#18212F"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:id="@+id/storageText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="#18212F"
        android:padding="16dp"/>

    <TextView
        android:id="@+id/ramText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="#18212F"
        android:padding="16dp"/>

    <Button
        android:id="@+id/scanButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SCAN DEVICE"
        android:layout_marginTop="30dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="V1.0 safely displays device storage and RAM information. Cleaner modules can be added in later versions."
        android:textSize="14sp"
        android:textColor="#5F6B7A"
        android:layout_marginTop="24dp"/>
</LinearLayout>
